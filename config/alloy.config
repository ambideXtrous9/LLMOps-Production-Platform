// ==============================================================================
// Grafana Alloy Telemetry Configuration (Plane 5)
// ==============================================================================
// Replaces deprecated Promtail.
// Acts as unified agent for:
//  1. Container Log Collection (shipping to Grafana Loki)
//  2. OpenTelemetry Trace Collection (receiving from LiteLLM/vLLM & exporting to Tempo)
//  3. OpenTelemetry Metrics Forwarding
// ==============================================================================

logging {
  level  = "info"
  format = "logfmt"
}

// ------------------------------------------------------------------------------
// 1. Loki Log Exporter
// ------------------------------------------------------------------------------
loki.write "loki_output" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ------------------------------------------------------------------------------
// 2. Container Log Discovery & Processing
// ------------------------------------------------------------------------------
// Discovers container logs via Docker engine (read-only)
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  // Label container name cleanly
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Filter only relevant LLMOps stack containers
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(vllm.*|litellm.*|kv-router.*|dcgm.*|langfuse.*|prometheus.*|tempo.*|alloy.*)"
    action        = "keep"
  }
}

loki.source.docker "docker_stream" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker_logs.output
  forward_to       = [loki.process.add_trace_metadata.receiver]
  relabel_rules    = discovery.relabel.docker_logs.rules
}

// Extract trace IDs from structured logs for correlation
loki.process "add_trace_metadata" {
  stage.regex {
    expression = "(?i)(trace_id|traceparent)[=:\"]+(?P<trace_id>[a-f0-9]{16,32})"
  }

  // Structured metadata, not a label: a label would open one Loki stream per trace
  stage.structured_metadata {
    values = {
      trace_id = "",
    }
  }

  forward_to = [loki.write.loki_output.receiver]
}

// ------------------------------------------------------------------------------
// 3. OpenTelemetry Distributed Tracing Pipeline (Gateway -> vLLM -> Tempo)
// ------------------------------------------------------------------------------
// Ingests OTLP traces from LiteLLM Proxy and vLLM Engine
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout     = "1s"
  send_batch_size = 256

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// Forward batched traces to Grafana Tempo storage
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
