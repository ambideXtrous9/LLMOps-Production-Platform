# ==============================================================================
# LLMOps settings. run_all.sh creates .env from this file (fresh secrets) on the
# first run; later runs only add settings that are missing. Empty = automatic.
# Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model (any Hugging Face repo; `./run_all.sh --model <repo>` sets MODEL)
# ------------------------------------------------------------------------------
# Empty: picked for this machine (GPU memory / RAM), see README "Models".
MODEL=
# Name clients use in API calls (empty: the repo name in lower case)
SERVED_MODEL_NAME=
# Context length in tokens (empty: by hardware, 8K-32K)
MAX_MODEL_LEN=
# Most requests batched together in one engine step (empty: 256 GPU, 16 CPU)
MAX_NUM_SEQS=
# Share of GPU memory for weights + KV cache (empty: 0.90, less when the GPU is shared)
GPU_MEMORY_UTILIZATION=
# auto | bfloat16 | half | float32 (auto: half on GPUs without bf16)
DTYPE=auto
# GPUs for one model (tensor parallel); the ones with the most free memory are used
GPU_COUNT=1
# CPU engine: GiB of RAM for the KV cache (empty: by RAM)
CPU_KV_CACHE_GB=
# Read token for private / gated models (empty: the one from `hf auth login`, if any)
HF_TOKEN=
# Where model weights are cached on this host
HF_CACHE_DIR=~/.cache/huggingface

# ------------------------------------------------------------------------------
# Engine (vLLM)
# ------------------------------------------------------------------------------
# Extra `vllm serve` flags, e.g. "--reasoning-parser qwen3" or "--enforce-eager"
VLLM_EXTRA_ARGS=
# How long a first boot may take (weights download + kernel compile) before the
# engine counts as unhealthy and is restarted
ENGINE_START_PERIOD=1800s

# ------------------------------------------------------------------------------
# Gateway (LiteLLM) - admin key, application key, workers
# ------------------------------------------------------------------------------
# Admin only (UI login, key management). Never give it to applications.
LITELLM_MASTER_KEY=sk-admin-__SECRET__
# Virtual key for applications (created at start; make more in the UI at :4000/ui)
LITELLM_API_KEY=sk-app-__SECRET__
# Gateway worker processes (empty: by CPU threads)
LITELLM_NUM_WORKERS=
POSTGRES_USER=llmops_admin
POSTGRES_DB=litellm_db
POSTGRES_PASSWORD=__SECRET__
REDIS_PASSWORD=__SECRET__

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=__SECRET__

# ------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------
# Gateway (:4000) and Grafana (:3001) - both need a login. 0.0.0.0 publishes them
# (open the firewall to your IP only; plain HTTP, put TLS in front for wider use).
PUBLIC_BIND_ADDRESS=127.0.0.1
# Everything else (engine, Prometheus) - keep 127.0.0.1, use an SSH tunnel
BIND_ADDRESS=127.0.0.1
# Public IP / DNS name, only used to print URLs
PUBLIC_HOST=
# Host ports. A port another program uses is moved to the next free one (saved here).
LITELLM_PORT=4000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
VLLM_PORT=8000

# ------------------------------------------------------------------------------
# Versions (pinned; bump deliberately, then ./run_all.sh)
# ------------------------------------------------------------------------------
VLLM_VERSION=v0.32.0
LITELLM_VERSION=v1.104.1
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.3
LOKI_VERSION=3.0.0
ALLOY_VERSION=v1.1.0
DCGM_EXPORTER_VERSION=4.5.2-4.8.1-ubuntu22.04
PROMETHEUS_RETENTION=15d
