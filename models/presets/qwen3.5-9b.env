# Qwen3.5-9B: vision-language, hybrid attention, tools + thinking, 128K ctx (>=24 GB accelerator)
# Verified: 1x A100-SXM4-40GB, vLLM v0.31.0, 2026-10-08 (eval gate 8/8, P95 TTFT 0.11s, ~74 tok/s/stream)
MODEL_NAME=Qwen/Qwen3.5-9B
MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
SERVED_MODEL_NAME=qwen3.5-9b
MODEL_DTYPE=auto
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.90
VLLM_MODEL_ARGS="--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --default-chat-template-kwargs.enable_thinking=false --limit-mm-per-prompt.image=4 --limit-mm-per-prompt.video=1 --override-generation-config.temperature=0.7 --override-generation-config.top_p=0.8 --override-generation-config.top_k=20 --override-generation-config.presence_penalty=1.5"
MODEL_SUPPORTS_REASONING=true
MODEL_REASONING_BY_DEFAULT=false
MODEL_SUPPORTS_TOOLS=true
MODEL_SUPPORTS_VISION=true
MODEL_THINKING_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": true}}'
# CPU engine (llama.cpp): pinned GGUF build of the same model + llama-server flags
GGUF_REPO=unsloth/Qwen3.5-9B-GGUF
GGUF_FILE=Qwen3.5-9B-Q4_K_M.gguf
GGUF_REVISION=3885219b6810b007914f3a7950a8d1b469d598a5
LLAMACPP_MODEL_ARGS="--reasoning off --reasoning-format deepseek --temp 0.7 --top-p 0.8 --top-k 20 --presence-penalty 1.5 --mmproj-url https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/3885219b6810b007914f3a7950a8d1b469d598a5/mmproj-F16.gguf --mmproj /models/Qwen3.5-9B-mmproj-F16.gguf"
EVAL_MIN_ACCURACY=0.85
EVAL_MAX_TTFT=1.5
# Speed gate sized for the slowest GPU this preset is picked for (24 GB L4 class, ~300 GB/s);
# the A100 does ~74 tok/s - raise it in .env to catch regressions on faster hardware.
EVAL_MIN_TPS=10
