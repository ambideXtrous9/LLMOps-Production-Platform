# Qwen3-0.6B: small text model with tools + thinking; default for CPU-only hosts and small GPUs
# Verified: vLLM CPU backend v0.31.0 on 30 vCPU AMD EPYC (AVX2), 2026-10-08 (~0.1s TTFT, ~50 tok/s/stream)
MODEL_NAME=Qwen/Qwen3-0.6B
MODEL_REVISION=main
SERVED_MODEL_NAME=qwen3-0.6b
MODEL_DTYPE=auto
MAX_MODEL_LEN=auto
GPU_MEMORY_UTILIZATION=0.90
VLLM_MODEL_ARGS="--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser hermes --default-chat-template-kwargs.enable_thinking=false"
MODEL_SUPPORTS_REASONING=true
MODEL_REASONING_BY_DEFAULT=false
MODEL_SUPPORTS_TOOLS=true
MODEL_SUPPORTS_VISION=false
MODEL_THINKING_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": true}}'
EVAL_MIN_ACCURACY=0.60
EVAL_MAX_TTFT=3.0
EVAL_MIN_TPS=10
