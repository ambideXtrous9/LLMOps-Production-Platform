# Qwen3-4B: text model with tools + thinking; default for CPU-only hosts and 10-24 GB GPUs
# Verified: vLLM CPU backend v0.31.0 on 30 vCPU AMD EPYC (AVX2), 2026-10-08 (13/13 checks, eval gate 8/8, ~10 tok/s/stream)
MODEL_NAME=Qwen/Qwen3-4B
MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
SERVED_MODEL_NAME=qwen3-4b
MODEL_DTYPE=auto
MAX_MODEL_LEN=auto
GPU_MEMORY_UTILIZATION=0.90
VLLM_MODEL_ARGS="--reasoning-parser qwen3 --default-chat-template-kwargs.enable_thinking=false --enable-auto-tool-choice --tool-call-parser hermes"
MODEL_SUPPORTS_REASONING=true
MODEL_REASONING_BY_DEFAULT=false
MODEL_SUPPORTS_TOOLS=true
MODEL_SUPPORTS_VISION=false
MODEL_THINKING_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": true}}'
EVAL_MIN_ACCURACY=0.75
EVAL_MAX_TTFT=3.0
EVAL_MIN_TPS=8
