# SmolLM2-360M-Instruct: tiny text model for 4 GB dev GPUs (GTX 1650 class) and smoke tests
# Not yet verified on vLLM v0.31.0 (previous dev profile ran it on v0.6.6 with FP16)
MODEL_NAME=HuggingFaceTB/SmolLM2-360M-Instruct
MODEL_REVISION=main
SERVED_MODEL_NAME=smollm2-360m
MODEL_DTYPE=half
MAX_MODEL_LEN=2048
GPU_MEMORY_UTILIZATION=0.60
VLLM_MODEL_ARGS="--enforce-eager --max-num-seqs 64"
MODEL_SUPPORTS_REASONING=false
MODEL_REASONING_BY_DEFAULT=false
MODEL_SUPPORTS_TOOLS=false
MODEL_SUPPORTS_VISION=false
MODEL_THINKING_EXTRA_BODY=
EVAL_MIN_ACCURACY=0.40
EVAL_MAX_TTFT=2.0
EVAL_MIN_TPS=15
